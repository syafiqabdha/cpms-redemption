# CPMS Autonomous Parking Redemption Engine Configuration
APP_NAME="CPMS Autonomous Parking Redemption Gateway"
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Pepper (HMAC-SHA256 secret vault pepper - MUST be kept secret in production)
SECRET_PEPPER=dev-secret-pepper-change-in-production

# CORS (comma-separated origins or *)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Logging (DEBUG, INFO, WARNING, ERROR; format: json or text)
LOG_LEVEL=INFO
LOG_FORMAT=json

# Operating Window & Timezone (Singapore Time UTC+8, 12:00 PM - 3:00 PM)
OPERATING_TIMEZONE=Asia/Singapore
OPERATING_START_HOUR=12
OPERATING_START_MINUTE=0
OPERATING_END_HOUR=15
OPERATING_END_MINUTE=0

# Business Rules
MIN_RECEIPT_SPEND=30.00
VOUCHER_EXPIRY_HOURS=2

# Infrastructure (PostgreSQL & Redis)
DATABASE_URL=postgresql+asyncpg://cpms_user:cpms_pass@localhost:5432/cpms_db
REDIS_URL=redis://localhost:6379/0
